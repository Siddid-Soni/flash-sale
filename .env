DATABASE_URL=postgresql://actix:actix@127.0.0.1:5432/flash_sale
REDIS_URL=redis://127.0.0.1:6379
# Order status cache (status:<ticket>); the same Redis locally, a separate cluster in production
READ_CACHE_URL=redis://127.0.0.1:6379
KAFKA_BROKERS=localhost:9092
CHECKOUT_TOPIC=orders.checkout
CHECKOUT_PARTITIONS=6
KAFKA_DELIVERY_TIMEOUT_MS=30000
DB_POOL_SIZE=10
JWT_SECRET=dev-secret-change-me
JWT_TTL_SECS=3600
ADMIN_TOKEN=dev-admin-token
PAYMENT_WINDOW_SECS=300
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_DELAY_MS=2000
# Where clients reach the API (the fake provider's payment page lives under it)
PUBLIC_BASE_URL=http://localhost:8080
# Where the fake payment page sends the browser back to (/?sale=<id>); default PUBLIC_BASE_URL.
# With the Vite dev server (npm run dev) as the frontend, set it to http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# Where the fake provider delivers webhooks (http only); default PUBLIC_BASE_URL/v1/payments/webhook
# PAYMENT_WEBHOOK_URL=http://localhost:8080/v1/payments/webhook
# Shared secret that signs webhooks (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Order processor: messages in flight per partition, and a cap per second (0 = unlimited)
PROCESSOR_CONCURRENCY=32
PROCESSOR_MAX_PER_SEC=0
