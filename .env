# Development settings for running the services locally (cargo run, docker compose).
# The secrets below (JWT_SECRET, ADMIN_TOKEN, PAYMENT_WEBHOOK_SECRET) are placeholders:
# never reuse them anywhere real.
DATABASE_URL=postgresql://actix:actix@127.0.0.1:5432/flash_sale
REDIS_URL=redis://127.0.0.1:6379
# Order status cache (status:<ticket>): its own Redis (compose: redis-cache on 6380)
READ_CACHE_URL=redis://127.0.0.1:6380
KAFKA_BROKERS=localhost:9092
CHECKOUT_TOPIC=orders.checkout
CHECKOUT_PARTITIONS=6
KAFKA_DELIVERY_TIMEOUT_MS=30000
DB_POOL_SIZE=10
JWT_SECRET=dev-secret-change-me
JWT_TTL_SECS=3600
ADMIN_TOKEN=dev-admin-token
PAYMENT_WINDOW_SECS=300
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_DELAY_MS=2000
# Where clients reach the API
PUBLIC_BASE_URL=http://localhost:8080
# Where the fake payment page sends the browser back to (/?sale=<id>); default PUBLIC_BASE_URL.
# With the Vite dev server (npm run dev) as the frontend, set it to http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# The fake payment provider is a service of its own (cargo run --bin fake_payment_provider).
# Where it listens, and where the order processor and the expiration worker call its API
PROVIDER_BIND_ADDR=127.0.0.1:8090
PAYMENT_PROVIDER_URL=http://127.0.0.1:8090
# Where users reach its payment page: the provider's own address, outside the gateway (compose uses the same)
PAYMENT_PAGE_BASE_URL=http://localhost:8090
# Where it delivers webhooks (http only): an order processor, which serves them on PROCESSOR_HTTP_ADDR
# (compose sends them through the gateway, http://gateway/v1/payments/webhook)
PROCESSOR_HTTP_ADDR=0.0.0.0:8081
PAYMENT_WEBHOOK_URL=http://127.0.0.1:8081/v1/payments/webhook
# Shared secret that signs webhooks (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Order processor: messages in flight per partition, and a cap per second (0 = unlimited)
PROCESSOR_CONCURRENCY=32
PROCESSOR_MAX_PER_SEC=0
# Expiration worker: orders expired per pass, sleep between idle passes (ms),
# how often recently expired orders are swept for a missed status or session step (s)
EXPIRY_BATCH=200
EXPIRY_INTERVAL_MS=250
EXPIRY_SWEEP_SECS=60
